# FreeAgent IDE configuration
HOST=127.0.0.1
PORT=8765

# Default model provider: ollama | openai
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.2:3b

OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible API (Groq, OpenRouter, LM Studio, etc.)
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=sk-...

# Per-agent model overrides (optional)
# PLANNER_MODEL=llama3.2:3b
# CODER_MODEL=qwen2.5-coder:7b
# REVIEWER_MODEL=llama3.2:3b
# TESTER_MODEL=llama3.2:3b

REQUIRE_WRITE_APPROVAL=true
REQUIRE_TERMINAL_APPROVAL=true
